DATABASE_URL=sqlite:///./storage/app.db
STORAGE_DIR=./storage/datasets
MAX_UPLOAD_SIZE_MB=500
DEBUG=true

# --- LLM provider ---
# "ollama" (local, free) or "openrouter" (free-tier fallback)
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=mistral:7b

# Only needed if LLM_PROVIDER=openrouter. Check
# https://openrouter.ai/models?fmt=table&max_price=0 for current free models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=